<Window x:Class="YouTubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Downloader" Height="550" Width="750"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ссылка YouTube:" FontWeight="Bold" Margin="10,10,0,5"/>
        <TextBox x:Name="UrlTextBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" 
                 Grid.Row="1" Margin="10,0,10,10" Height="30"/>

        <WrapPanel Grid.Row="2" Margin="10,0,0,10">
            <Button Content="Загрузить информацию" Width="150" Height="30" 
                    Command="{Binding LoadCommand}" Margin="0,0,10,0"/>
            <Button Content="Отмена" Width="80" Height="30" 
                    Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
            <Button Content="Логи" Width="80" Height="30" 
                    Command="{Binding OpenLogsCommand}" Margin="0,0,10,0"/>
            <Button Content="Открыть папку" Width="110" Height="30" 
                    Command="{Binding OpenFolderCommand}" Margin="0,0,10,0"/>
            <Button Content="Проверить обновления" Width="150" Height="30" 
                    Command="{Binding CheckUpdatesCommand}"/>
        </WrapPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,0,0,10">
            <RadioButton Content="Видео" IsChecked="{Binding IsVideoMode}" Margin="0,0,15,0"/>
            <RadioButton Content="Аудио (MP3)" IsChecked="{Binding IsAudioMode}"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"
                 DisplayMemberPath="DisplayName" Grid.Row="4" Margin="10,0,10,10"/>

        <Grid Grid.Row="4" Background="#80FFFFFF" Visibility="{Binding IsSpinnerVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Width="500" Height="50" IsIndeterminate="True" />
                <TextBlock Text="{Binding SpinnerText}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ProgressBar Value="{Binding ProgressValue}" Height="5" Margin="10,0,10,10" 
                     Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}"
                     Grid.Row="5"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="10,10,10,10">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Width="450" Margin="0,0,15,0"/>
            <Button Content="Скачать" Width="100" Height="30" 
                    Command="{Binding DownloadCommand}"/>
        </StackPanel>
    </Grid>
</Window>