<UserControl x:Class="YouTubeDownloader.Views.ProgressTaskControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Margin="5">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,5">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Status}" Margin="10,0,0,0" FontSize="11" 
                           VerticalAlignment="Center" Foreground="Gray"/>
            </StackPanel>

            <Button Grid.Row="0" Grid.Column="1" Content="✖" Width="25" Height="25" 
                    Command="{Binding CancelCommand}" ToolTip="Отменить"
                    IsEnabled="{Binding IsActive}"/>

            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                         Value="{Binding Progress}" Height="20" Margin="0,5,0,5">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Progress}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Завершено">
                                <Setter Property="Foreground" Value="Green"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Отменено">
                                <Setter Property="Foreground" Value="Orange"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Status}" 
                       Foreground="Gray" FontSize="11"/>

            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:F0}%}" 
                       FontSize="11" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</UserControl>