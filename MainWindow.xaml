<Window x:Class="YouTubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Downloader" Height="550" Width="750"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ссылка YouTube:" FontWeight="Bold" Margin="10,10,0,5"/>
        <TextBox x:Name="UrlTextBox" Text="https://www.youtube.com/watch?v=YWRw_fTrh9s" Grid.Row="1" Margin="10,0,10,10" Height="30"/>

        <WrapPanel Grid.Row="2" Margin="10,0,0,10">
            <Button x:Name="LoadButton" Content="Загрузить информацию" Width="150" Height="30" Click="LoadButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="80" Height="30" Click="CancelButton_Click" IsEnabled="False" Margin="0,0,10,0"/>
            <Button x:Name="OpenLogsButton" Content="Логи" Width="80" Height="30" Click="OpenLogsButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="OpenFolderButton" Content="Открыть папку" Width="110" Height="30" Click="OpenFolderButton_Click" IsEnabled="False" Margin="0,0,10,0"/>
            <Button x:Name="CheckUpdatesButton" Content="Проверить обновления" Width="150" Height="30" Click="CheckUpdatesButton_Click"/>
        </WrapPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,0,0,10">
            <RadioButton x:Name="VideoRadio" Content="Видео" IsChecked="True" Checked="MediaType_Changed" Margin="0,0,15,0"/>
            <RadioButton x:Name="AudioRadio" Content="Аудио (MP3)" Checked="MediaType_Changed"/>
        </StackPanel>

        <ListBox x:Name="FormatsListBox" Grid.Row="4" DisplayMemberPath="DisplayName" Margin="10,0,10,10"/>

        <!-- Спиннер по центру -->
        <Grid Grid.Row="4" Background="#80FFFFFF" Visibility="Collapsed" x:Name="SpinnerOverlay">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Width="500" Height="50" IsIndeterminate="True" />
                <TextBlock x:Name="SpinnerText" Text="Загрузка..." Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="ProgressBar" Grid.Row="5" Height="5" Margin="10,0,10,10" Visibility="Collapsed"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="10,10,10,10">
            <TextBlock x:Name="StatusText" Text="Готов" VerticalAlignment="Center" Width="450" Margin="0,0,15,0"/>
            <Button x:Name="DownloadButton" Content="Скачать" Width="100" Height="30" IsEnabled="False" Click="DownloadButton_Click"/>
        </StackPanel>

        <Border x:Name="UpdatePanel" Grid.RowSpan="7" Background="#CC000000" Visibility="Collapsed">
            <Border Background="White" Width="400" Height="250" CornerRadius="10" VerticalAlignment="Center">
                <StackPanel Margin="20">
                    <TextBlock x:Name="UpdateTitle" Text="Доступны обновления" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <ListBox x:Name="UpdateListBox" Height="120" Margin="0,0,0,15">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock FontWeight="Bold" Text="{Binding ToolName}"/>
                                    <TextBlock Text="{Binding CurrentVersion}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ProgressBar x:Name="UpdateProgressBar" Height="20" Margin="0,0,0,15" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="UpdateYesButton" Content="Обновить" Width="80" Margin="0,0,10,0" Click="UpdateYes_Click"/>
                        <Button x:Name="UpdateNoButton" Content="Пропустить" Width="80" Click="UpdateNo_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>